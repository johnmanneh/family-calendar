{
  "expo": {
    "name": "it's for us",
    "slug": "when",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to scan family invite QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.songsanchaun.whenapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground-brand.png",
        "monochromeImage": "./assets/android-icon-monochrome-brand.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.songsanchaun.whenapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/brand/icon-512.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "allowBackup": false,
            "blockedPermissions": [
              "android.permission.READ_CALENDAR",
              "android.permission.WRITE_CALENDAR",
              "android.permission.SYSTEM_ALERT_WINDOW"
            ]
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon-1024.png",
          "color": "#1a8fa8"
        }
      ],
      "expo-localization",
      "expo-speech-recognition",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan family invite QR codes.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone to create appointments by voice.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "when",
    "extra": {
      "eas": {
        "projectId": "926305bd-ac2a-414c-b6b0-04c45b48a607"
      }
    }
  }
}
